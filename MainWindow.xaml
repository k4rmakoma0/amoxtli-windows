<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Amoxtli.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Amoxtli">
    <Window.SystemBackdrop><MicaBackdrop /></Window.SystemBackdrop>
    <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" AllowDrop="True" DragOver="Root_DragOver" Drop="Root_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <MenuBar>
            <MenuBarItem Title="Archivo">
                <MenuFlyoutItem Text="Abrir archivo…" Click="OpenFile_Click"><MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Key="O" Modifiers="Control"/></MenuFlyoutItem.KeyboardAccelerators></MenuFlyoutItem>
                <MenuFlyoutItem Text="Abrir carpeta…" Click="OpenFolder_Click"><MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Key="O" Modifiers="Control,Shift"/></MenuFlyoutItem.KeyboardAccelerators></MenuFlyoutItem>
                <MenuFlyoutItem Text="Volver a cargar" Click="Reload_Click"><MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Key="F5"/></MenuFlyoutItem.KeyboardAccelerators></MenuFlyoutItem>
                <MenuFlyoutItem Text="Mostrar en el Explorador" Click="Reveal_Click"/>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="Elegir como app predeterminada…" Click="DefaultApps_Click"/>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="Cerrar ventana" Click="Close_Click"/>
            </MenuBarItem>
            <MenuBarItem Title="Edición">
                <MenuFlyoutItem Text="Copiar Markdown completo" Click="CopyMarkdown_Click"><MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Key="C" Modifiers="Control,Shift"/></MenuFlyoutItem.KeyboardAccelerators></MenuFlyoutItem>
                <MenuFlyoutItem Text="Pegar Markdown para leer" Click="Paste_Click"><MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Key="V" Modifiers="Control" Invoked="PasteAccelerator_Invoked"/></MenuFlyoutItem.KeyboardAccelerators></MenuFlyoutItem>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="Buscar en el documento" Click="Find_Click"><MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Key="F" Modifiers="Control"/></MenuFlyoutItem.KeyboardAccelerators></MenuFlyoutItem>
            </MenuBarItem>
            <MenuBarItem Title="Ver">
                <ToggleMenuFlyoutItem x:Name="SidebarMenu" Text="Panel de navegación" IsChecked="True" Click="Sidebar_Click"><ToggleMenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Key="B" Modifiers="Control"/></ToggleMenuFlyoutItem.KeyboardAccelerators></ToggleMenuFlyoutItem>
                <ToggleMenuFlyoutItem x:Name="SourceMenu" Text="Ver código Markdown" Click="Source_Click"><ToggleMenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Key="U" Modifiers="Control"/></ToggleMenuFlyoutItem.KeyboardAccelerators></ToggleMenuFlyoutItem>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="Aumentar texto" Click="ZoomIn_Click"/>
                <MenuFlyoutItem Text="Reducir texto" Click="ZoomOut_Click"/>
                <MenuFlyoutItem Text="Restablecer texto" Click="ZoomReset_Click"/>
            </MenuBarItem>
            <MenuBarItem Title="Ayuda">
                <MenuFlyoutItem Text="Guía de Markdown" Click="Welcome_Click"/>
                <MenuFlyoutItem Text="Acerca de Amoxtli" Click="About_Click"/>
            </MenuBarItem>
        </MenuBar>
        <Grid Grid.Row="1" Padding="12,4,16,12" ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="4">
                <ToggleButton x:Name="SidebarButton" Click="SidebarToggle_Click" IsChecked="True" ToolTipService.ToolTip="Ocultar panel de navegación (Ctrl+B)" AutomationProperties.Name="Ocultar panel de navegación"><FontIcon x:Name="SidebarIcon" Glyph="&#xE89F;" FontSize="16"/></ToggleButton>
                <Button x:Name="BackButton" Click="Back_Click" IsEnabled="False" ToolTipService.ToolTip="Atrás (Alt+Izquierda)" AutomationProperties.Name="Atrás"><FontIcon Glyph="&#xE72B;" FontSize="16"/><Button.KeyboardAccelerators><KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="BackAccelerator_Invoked"/></Button.KeyboardAccelerators></Button>
                <Button x:Name="ForwardButton" Click="Forward_Click" IsEnabled="False" ToolTipService.ToolTip="Adelante (Alt+Derecha)" AutomationProperties.Name="Adelante"><FontIcon Glyph="&#xE72A;" FontSize="16"/><Button.KeyboardAccelerators><KeyboardAccelerator Key="Right" Modifiers="Menu" Invoked="ForwardAccelerator_Invoked"/></Button.KeyboardAccelerators></Button>
                <Button Click="OpenFile_Click" ToolTipService.ToolTip="Abrir archivo (Ctrl+O)"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8A5;" FontSize="16"/><TextBlock Text="Abrir"/></StackPanel></Button>
                <Button Click="OpenFolder_Click" ToolTipService.ToolTip="Abrir carpeta (Ctrl+Mayús+O)" AutomationProperties.Name="Abrir carpeta"><FontIcon Glyph="&#xE8B7;" FontSize="16"/></Button>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                <TextBlock x:Name="DocumentName" Text="Bienvenido a Amoxtli" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="DocumentPath" Text="Tu espacio de lectura de Markdown" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Click="Find_Click" ToolTipService.ToolTip="Buscar (Ctrl+F)" AutomationProperties.Name="Buscar en el documento"><FontIcon Glyph="&#xE721;" FontSize="16"/></Button>
                <Button Click="Settings_Click" ToolTipService.ToolTip="Preferencias de lectura" AutomationProperties.Name="Preferencias de lectura"><FontIcon Glyph="&#xE713;" FontSize="16"/></Button>
            </StackPanel>
        </Grid>
        <InfoBar x:Name="Notice" Grid.Row="2" IsOpen="False" Margin="12,0,12,8" Severity="Informational"/>
        <SplitView x:Name="NavigationSplit" Grid.Row="3" DisplayMode="Inline" IsPaneOpen="True" OpenPaneLength="278" CompactPaneLength="0" PaneBackground="{ThemeResource LayerFillColorDefaultBrush}">
            <SplitView.Pane>
                <Pivot x:Name="NavigationPivot">
                    <PivotItem Header="Archivos">
                        <Grid Margin="0,0,0,12">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock x:Name="FolderName" Text="Sin carpeta abierta" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="8,4,8,12" TextTrimming="CharacterEllipsis"/>
                            <Button x:Name="FolderPrompt" Grid.Row="1" Content="Abrir una carpeta…" Click="OpenFolder_Click" HorizontalAlignment="Stretch" Margin="8,0,8,12"/>
                            <TreeView x:Name="FileTree" Grid.Row="2" SelectionMode="Single" ItemInvoked="FileTree_ItemInvoked" Expanding="FileTree_Expanding">
                                <TreeView.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="{Binding Content.Glyph}" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{Binding Content.Name}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel></DataTemplate></TreeView.ItemTemplate>
                            </TreeView>
                        </Grid>
                    </PivotItem>
                    <PivotItem Header="Contenido">
                        <Grid>
                            <TextBlock x:Name="OutlineEmpty" Text="Los encabezados del documento aparecerán aquí." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="8,12"/>
                            <ListView x:Name="OutlineList" SelectionChanged="Outline_SelectionChanged" Margin="0,4,0,12">
                                <ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}" Margin="{Binding Indent}" TextWrapping="Wrap" FontSize="13"/></DataTemplate></ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </PivotItem>
                </Pivot>
            </SplitView.Pane>
            <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,0" CornerRadius="8,0,0,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid x:Name="FindBar" Visibility="Collapsed" Padding="20,12" ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox" PlaceholderText="Buscar en el documento" TextChanged="Search_TextChanged" KeyDown="Search_KeyDown" AutomationProperties.Name="Buscar en el documento"/>
                    <TextBlock x:Name="SearchCount" Grid.Column="1" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <Button Grid.Column="2" Click="PreviousMatch_Click" AutomationProperties.Name="Coincidencia anterior"><FontIcon Glyph="&#xE70E;" FontSize="12"/></Button>
                    <Button Grid.Column="3" Click="NextMatch_Click" AutomationProperties.Name="Coincidencia siguiente"><FontIcon Glyph="&#xE70D;" FontSize="12"/></Button>
                    <Button Grid.Column="4" Click="CloseFind_Click" AutomationProperties.Name="Cerrar búsqueda"><FontIcon Glyph="&#xE711;" FontSize="12"/></Button>
                </Grid>
                <ScrollViewer x:Name="ReaderScroll" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" ViewChanged="Reader_ViewChanged">
                    <StackPanel x:Name="DocumentPanel" MaxWidth="920" Padding="40,32,40,64" HorizontalAlignment="Stretch" Spacing="4"/>
                </ScrollViewer>
                <ScrollViewer x:Name="SourceScroll" Grid.Row="1" Visibility="Collapsed" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="SourceText" Padding="32" FontFamily="Cascadia Mono, Consolas" FontSize="14" IsTextSelectionEnabled="True" TextWrapping="NoWrap"/>
                </ScrollViewer>
            </Grid>
        </SplitView>
        <Grid Grid.Row="4" Padding="16,8" ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Text="Solo lectura" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="ZoomText" Grid.Column="1" Text="100 %" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock x:Name="ProgressText" Grid.Column="2" Text="0 %" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Grid>
    </Grid>
</Window>
