<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Amoxtli.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:Amoxtli.Services"
    Title="Amoxtli">
    <Window.SystemBackdrop><MicaBackdrop /></Window.SystemBackdrop>
    <Grid x:Name="Root" Background="Transparent" AllowDrop="True" DragOver="Root_DragOver" Drop="Root_Drop">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideNavigation">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="740"/></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="NavigationSplit.DisplayMode" Value="Inline"/>
                        <Setter Target="NavigationSplit.PaneBackground" Value="Transparent"/>
                        <Setter Target="ReaderSurface.Translation" Value="0,0,16"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="NarrowNavigation">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0"/></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="NavigationSplit.DisplayMode" Value="Overlay"/>
                        <Setter Target="NavigationSplit.PaneBackground" Value="{ThemeResource SolidBackgroundFillColorBaseBrush}"/>
                        <Setter Target="ReaderSurface.Translation" Value="0,0,0"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <MenuBar>
            <MenuBarItem services:LocalizedText.Text="MenuFile">
                <MenuFlyoutItem services:LocalizedText.Text="OpenFile" Click="OpenFile_Click"><MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Key="O" Modifiers="Control"/></MenuFlyoutItem.KeyboardAccelerators></MenuFlyoutItem>
                <MenuFlyoutItem services:LocalizedText.Text="OpenFolder" Click="OpenFolder_Click"><MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Key="O" Modifiers="Control,Shift"/></MenuFlyoutItem.KeyboardAccelerators></MenuFlyoutItem>
                <MenuFlyoutItem services:LocalizedText.Text="Reload" Click="Reload_Click"><MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Key="F5"/></MenuFlyoutItem.KeyboardAccelerators></MenuFlyoutItem>
                <MenuFlyoutItem services:LocalizedText.Text="Reveal" Click="Reveal_Click"/>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem services:LocalizedText.Text="DefaultApps" Click="DefaultApps_Click"/>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem services:LocalizedText.Text="CloseWindow" Click="Close_Click"/>
            </MenuBarItem>
            <MenuBarItem services:LocalizedText.Text="MenuEdit">
                <MenuFlyoutItem services:LocalizedText.Text="CopyMarkdown" Click="CopyMarkdown_Click"><MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Key="C" Modifiers="Control,Shift"/></MenuFlyoutItem.KeyboardAccelerators></MenuFlyoutItem>
                <MenuFlyoutItem services:LocalizedText.Text="PasteMarkdown" Click="Paste_Click"><MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Key="V" Modifiers="Control" Invoked="PasteAccelerator_Invoked"/></MenuFlyoutItem.KeyboardAccelerators></MenuFlyoutItem>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem services:LocalizedText.Text="Find" Click="Find_Click"><MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Key="F" Modifiers="Control"/></MenuFlyoutItem.KeyboardAccelerators></MenuFlyoutItem>
            </MenuBarItem>
            <MenuBarItem services:LocalizedText.Text="MenuView">
                <ToggleMenuFlyoutItem x:Name="SidebarMenu" services:LocalizedText.Text="Navigation" IsChecked="True" Click="Sidebar_Click"><ToggleMenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Key="B" Modifiers="Control"/></ToggleMenuFlyoutItem.KeyboardAccelerators></ToggleMenuFlyoutItem>
                <ToggleMenuFlyoutItem x:Name="SourceMenu" services:LocalizedText.Text="Source" Click="Source_Click"><ToggleMenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Key="U" Modifiers="Control"/></ToggleMenuFlyoutItem.KeyboardAccelerators></ToggleMenuFlyoutItem>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem services:LocalizedText.Text="ZoomIn" Click="ZoomIn_Click"/>
                <MenuFlyoutItem services:LocalizedText.Text="ZoomOut" Click="ZoomOut_Click"/>
                <MenuFlyoutItem services:LocalizedText.Text="ZoomReset" Click="ZoomReset_Click"/>
            </MenuBarItem>
            <MenuBarItem services:LocalizedText.Text="MenuHelp">
                <MenuFlyoutItem services:LocalizedText.Text="Guide" Click="Welcome_Click"/>
                <MenuFlyoutItem services:LocalizedText.Text="About" Click="About_Click"/>
            </MenuBarItem>
        </MenuBar>
        <Grid Grid.Row="1" Padding="12,4,16,12" ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="4">
                <ToggleButton x:Name="SidebarButton" Click="SidebarToggle_Click" IsChecked="True"><FontIcon x:Name="SidebarIcon" Glyph="&#xE89F;" FontSize="16" MirroredWhenRightToLeft="True"/></ToggleButton>
                <Button x:Name="BackButton" Click="Back_Click" IsEnabled="False" services:LocalizedText.ToolTip="BackTip" services:LocalizedText.Name="Back"><FontIcon Glyph="&#xE72B;" FontSize="16"/><Button.KeyboardAccelerators><KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="BackAccelerator_Invoked"/></Button.KeyboardAccelerators></Button>
                <Button x:Name="ForwardButton" Click="Forward_Click" IsEnabled="False" services:LocalizedText.ToolTip="ForwardTip" services:LocalizedText.Name="Forward"><FontIcon Glyph="&#xE72A;" FontSize="16"/><Button.KeyboardAccelerators><KeyboardAccelerator Key="Right" Modifiers="Menu" Invoked="ForwardAccelerator_Invoked"/></Button.KeyboardAccelerators></Button>
                <Button Click="OpenFile_Click" services:LocalizedText.ToolTip="OpenFileTip"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8A5;" FontSize="16"/><TextBlock services:LocalizedText.Text="Open"/></StackPanel></Button>
                <Button Click="OpenFolder_Click" services:LocalizedText.ToolTip="OpenFolderTip" services:LocalizedText.Name="OpenFolder"><FontIcon Glyph="&#xE8B7;" FontSize="16"/></Button>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                <TextBlock x:Name="DocumentName" services:LocalizedText.Text="WelcomeTitle" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="DocumentPath" services:LocalizedText.Text="WelcomeSubtitle" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Click="Find_Click" services:LocalizedText.ToolTip="FindTip" services:LocalizedText.Name="Find"><FontIcon Glyph="&#xE721;" FontSize="16"/></Button>
                <Button Click="Settings_Click" services:LocalizedText.ToolTip="Preferences" services:LocalizedText.Name="Preferences"><FontIcon Glyph="&#xE713;" FontSize="16"/></Button>
            </StackPanel>
        </Grid>
        <InfoBar x:Name="Notice" Grid.Row="2" IsOpen="False" Margin="12,0,12,8" Severity="Informational"/>
        <!-- A sibling receives the reader's shadow without adding a sidebar divider. -->
        <Grid x:Name="WorkspaceShadowReceiver" Grid.Row="3" Background="Transparent" IsHitTestVisible="False"/>
        <SplitView x:Name="NavigationSplit" Grid.Row="3" DisplayMode="Inline" IsPaneOpen="True" OpenPaneLength="278" CompactPaneLength="0" PaneBackground="Transparent" BorderThickness="0" FlowDirection="LeftToRight">
            <SplitView.Pane>
                <Pivot x:Name="NavigationPivot" Margin="4,0,4,4" Background="Transparent">
                    <PivotItem services:LocalizedText.Text="Files">
                        <Grid Margin="0,0,0,12">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock x:Name="FolderName" services:LocalizedText.Text="NoFolder" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="8,4,8,12" TextTrimming="CharacterEllipsis"/>
                            <Button x:Name="FolderPrompt" Grid.Row="1" services:LocalizedText.Text="FolderPrompt" Click="OpenFolder_Click" HorizontalAlignment="Stretch" Margin="8,0,8,12"/>
                            <TreeView x:Name="FileTree" Grid.Row="2" SelectionMode="Single" ItemInvoked="FileTree_ItemInvoked" Expanding="FileTree_Expanding">
                                <TreeView.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="{Binding Content.Glyph}" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{Binding Content.Name}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel></DataTemplate></TreeView.ItemTemplate>
                            </TreeView>
                        </Grid>
                    </PivotItem>
                    <PivotItem services:LocalizedText.Text="Contents">
                        <Grid>
                            <TextBlock x:Name="OutlineEmpty" services:LocalizedText.Text="OutlineEmpty" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="8,12"/>
                            <ListView x:Name="OutlineList" SelectionChanged="Outline_SelectionChanged" Margin="0,4,0,12">
                                <ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}" Margin="{Binding Indent}" TextWrapping="Wrap" FontSize="13"/></DataTemplate></ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </PivotItem>
                </Pivot>
            </SplitView.Pane>
            <Grid x:Name="ReaderSurface" Margin="8,2,12,6" Background="{ThemeResource LayerFillColorAltBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Translation="0,0,16">
                <Grid.Shadow><ThemeShadow x:Name="ReaderShadow"/></Grid.Shadow>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid x:Name="FindBar" Visibility="Collapsed" Padding="20,12" ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox" services:LocalizedText.Text="Find" TextChanged="Search_TextChanged" KeyDown="Search_KeyDown" services:LocalizedText.Name="Find"/>
                    <TextBlock x:Name="SearchCount" Grid.Column="1" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <Button Grid.Column="2" Click="PreviousMatch_Click" services:LocalizedText.Name="PreviousMatch"><FontIcon Glyph="&#xE70E;" FontSize="12"/></Button>
                    <Button Grid.Column="3" Click="NextMatch_Click" services:LocalizedText.Name="NextMatch"><FontIcon Glyph="&#xE70D;" FontSize="12"/></Button>
                    <Button Grid.Column="4" Click="CloseFind_Click" services:LocalizedText.Name="CloseFind"><FontIcon Glyph="&#xE711;" FontSize="12"/></Button>
                </Grid>
                <ScrollViewer x:Name="ReaderScroll" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" ViewChanged="Reader_ViewChanged">
                    <StackPanel x:Name="DocumentPanel" MaxWidth="920" Padding="40,32,40,64" HorizontalAlignment="Stretch" Spacing="4"/>
                </ScrollViewer>
                <ScrollViewer x:Name="SourceScroll" Grid.Row="1" Visibility="Collapsed" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
            </Grid>
        </SplitView>
        <Grid Grid.Row="4" Padding="16,8" ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" services:LocalizedText.Text="ReadOnly" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="ZoomText" Grid.Column="1" Text="100 %" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock x:Name="ProgressText" Grid.Column="2" Text="0 %" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Grid>
    </Grid>
</Window>
